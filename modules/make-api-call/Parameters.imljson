[
  {
    "name": "url",
    "type": "text",
    "label": "URL",
    "required": true,
    "help": "Path relative to `https://api.vatnode.dev/v1`, for example `/vat/DE811907980`. The full API reference is at https://vatnode.dev/docs."
  },
  {
    "name": "method",
    "type": "select",
    "label": "Method",
    "required": true,
    "default": "GET",
    "options": [
      { "label": "GET", "value": "GET" },
      { "label": "POST", "value": "POST" },
      { "label": "PATCH", "value": "PATCH" },
      { "label": "DELETE", "value": "DELETE" }
    ]
  },
  {
    "name": "headers",
    "type": "collection",
    "label": "Headers",
    "help": "Authorization is added automatically from the connection."
  },
  { "name": "qs", "type": "collection", "label": "Query String" },
  { "name": "body", "type": "any", "label": "Body" }
]
